<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.cineplex.administracion.controller.DashboardController">
    <stylesheets>
        <URL value="@/main/resources/css/styles.css" />
    </stylesheets>
   <children>
      <BorderPane fx:id="panelCentral" prefHeight="200.0" prefWidth="200.0" styleClass="root" stylesheets="@../css/styles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <left>
            <VBox alignment="CENTER" prefHeight="343.0" prefWidth="125.0" spacing="10.0" styleClass="side-panel" stylesheets="@../css/dashboard.css" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" onAction="#openPeliculasView" styleClass="nav-button" text="Peliculas" />
                  <Button mnemonicParsing="false" onAction="#openDirectoresView" styleClass="nav-button" text="Directores">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="nav-button" text="Cerrar Sesión" />
               </children>
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </left>
         <top>
            <HBox fx:id="titleBar" maxWidth="1.7976931348623157E308" prefHeight="25.0" spacing="10.0" styleClass="title-bar" stylesheets="@../css/styles.css" BorderPane.alignment="CENTER">
               <children>
                  <Label text="CinePlex - Dashboard" />
                  <Region maxWidth="1.7976931348623157E308" prefHeight="25.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnMinimizar" mnemonicParsing="false" prefHeight="5.0" prefWidth="29.0" styleClass="window-button" stylesheets="@../css/styles.css" text="-" />
                  <Button fx:id="btnCerrar" mnemonicParsing="false" prefHeight="5.0" prefWidth="29.0" styleClass="window-button-close" stylesheets="@../css/styles.css" text="x" />
               </children>
            </HBox>
         </top>
      </BorderPane>
   </children>
</AnchorPane>
