<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.cineplex.administracion.controller.LoginController">
    <stylesheets>
        <URL value="@/main/resources/css/styles.css" />
    </stylesheets>
   <children>
      <BorderPane styleClass="root" stylesheets="@../css/styles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <VBox alignment="TOP_CENTER" maxHeight="450.0" maxWidth="380.0" prefHeight="300.0" prefWidth="350.0" spacing="10.0" styleClass="auth-card" stylesheets="@../css/auth.css">
               <children>
                  <Label styleClass="auth-header-text" stylesheets="@../css/styles.css" text="Cineplex - Administración" />
                  <Label styleClass="auth-label" stylesheets="@../css/styles.css" text="Ingrese su Usuario..." />
                  <TextField fx:id="txtUsername" promptText="Username" styleClass="text-field">
                     <stylesheets>
                        <URL value="@../css/styles.css" />
                        <URL value="@../css/components.css" />
                     </stylesheets>
                  </TextField>
                  <Label styleClass="auth-label" text="Ingrese su Contraseña..." />
                  <PasswordField fx:id="pwField" promptText="Password" styleClass="password-field">
                     <stylesheets>
                        <URL value="@../css/styles.css" />
                        <URL value="@../css/components.css" />
                     </stylesheets>
                  </PasswordField>
                  <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="button-aero" stylesheets="@../css/components.css" text="Iniciar Sesión" />
                  <ImageView fitHeight="16.0" fitWidth="87.0" pickOnBounds="true" preserveRatio="true" />
                  <Label styleClass="auth-label" text="No tienes una cuenta?" />
                  <Button mnemonicParsing="false" onAction="#handleRegisterButton" styleClass="button-aero" stylesheets="@../css/components.css" text="Registrarse" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </center>
         <top>
            <HBox fx:id="titleBar" maxWidth="1.7976931348623157E308" prefHeight="25.0" spacing="10.0" styleClass="title-bar" stylesheets="@../css/styles.css" BorderPane.alignment="CENTER">
               <children>
                  <Label text="CinePlex - Iniciar Sesión" />
                  <Region maxWidth="1.7976931348623157E308" prefHeight="25.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnMinimizar" mnemonicParsing="false" prefHeight="5.0" prefWidth="29.0" styleClass="window-button" stylesheets="@../css/styles.css" text="-" />
                  <Button fx:id="btnCerrar" mnemonicParsing="false" prefHeight="5.0" prefWidth="29.0" styleClass="window-button-close" stylesheets="@../css/styles.css" text="x" />
               </children>
            </HBox>
         </top>
      </BorderPane>
   </children>
</AnchorPane>
