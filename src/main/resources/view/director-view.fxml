<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="main.java.com.pbcorporations.cineplex.administracion.controller.DirectorController">
    <stylesheets>
        <URL value="@/main/resources/css/styles.css" />
    </stylesheets>
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="390.0" prefWidth="152.0" spacing="10.0">
               <children>
                  <Label text="Registrar un director..." />
                  <Label text="Nombre del Director." />
                  <TextField fx:id="txtNombreDirector" />
                  <Label text="Apellido del Director." />
                  <TextField fx:id="txtApellidoDirector" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <TableView fx:id="tableDirectores" prefHeight="390.0" prefWidth="433.0">
              <columns>
                <TableColumn fx:id="columnId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="columnNombre" prefWidth="179.0" text="Nombre" />
                  <TableColumn fx:id="columnApellido" prefWidth="178.0" text="Apellido" />
              </columns>
            </TableView>
         </children>
      </HBox>
   </children>
</AnchorPane>
