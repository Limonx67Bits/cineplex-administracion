<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.cineplex.administracion.controller.PeliculaController">
    <stylesheets>
        <URL value="@/main/resources/css/styles.css" />
    </stylesheets>
   <children>
      <HBox layoutX="200.0" layoutY="150.0" prefHeight="100.0" prefWidth="200.0" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="390.0" prefWidth="151.0" spacing="7.0">
               <children>
                  <Label text="Agregar una pelicula..." />
                  <Label text="Tiulo de la pelicula." />
                  <TextField fx:id="txtTituloPelicula" />
                  <Label text="Duración (Minutos)." />
                  <TextField fx:id="txtDuracionMinutos" />
                  <Label text="URL del Poster." />
                  <TextField fx:id="txtUrlPoster" />
                  <ComboBox fx:id="cbClasificacion" prefWidth="150.0" promptText="Clasificacion" />
                  <ComboBox fx:id="cbGenero" prefWidth="150.0" promptText="Genero" />
                  <ComboBox fx:id="cbDirector" prefWidth="150.0" promptText="Director" />
                  <Button mnemonicParsing="false" onAction="#handleSaveMovie" text="Agregar" />
                  <Button mnemonicParsing="false" onAction="#handleUpdateMovie" text="Actualizar" />
                  <Button mnemonicParsing="false" onAction="#handleRemoveMovie" text="Eliminar" />
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
            <TableView fx:id="tablePeliculas" prefHeight="390.0" prefWidth="456.0">
              <columns>
                <TableColumn fx:id="columnTituloPelicula" prefWidth="117.0" text="Titulo" />
                <TableColumn fx:id="columnDuracionMinutos" prefWidth="56.0" text="Duración" />
                  <TableColumn fx:id="columnGenero" prefWidth="69.0" text="Genero" />
                  <TableColumn fx:id="columnClasificacion" prefWidth="99.0" text="Clasificacion" />
                  <TableColumn fx:id="columnDirector" prefWidth="103.0" text="Director" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </HBox>
   </children>
</AnchorPane>
